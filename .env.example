# Website Trust Assessment System configuration. Copy to .env and adjust if needed.
# The API binds to localhost by default and must not be exposed publicly.

WTAS_HOST=127.0.0.1
WTAS_PORT=8000

# Storage
WTAS_DB=data/website_trust_assessment.db
WTAS_SCREENSHOTS=data/screenshots

# Assessment behaviour
WTAS_CACHE_TTL=3600
WTAS_ASSESS_TIMEOUT=75
WTAS_CRAWL_TIMEOUT_MS=25000
WTAS_MAX_RESPONSE_BYTES=2500000
WTAS_ENABLE_PLAYWRIGHT=1

# Optional local narration via Ollama. Disabled by default; no cloud calls are made.
WTAS_LLM_ENABLED=0
WTAS_LLM_MODEL=qwen2.5:1.5b-instruct
WTAS_OLLAMA_URL=http://127.0.0.1:11434

# Comma-separated extra browser origins allowed to call the API.
WTAS_ALLOWED_ORIGINS=
