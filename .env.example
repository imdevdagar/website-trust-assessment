# Website Trust Assessment System configuration. Copy to .env and adjust if needed.
# The API binds to localhost by default and must not be exposed publicly.

TRUSTLENS_HOST=127.0.0.1
TRUSTLENS_PORT=8000

# Storage
TRUSTLENS_DB=data/trustlens.db
TRUSTLENS_SCREENSHOTS=data/screenshots

# Assessment behaviour
TRUSTLENS_CACHE_TTL=3600
TRUSTLENS_ASSESS_TIMEOUT=75
TRUSTLENS_CRAWL_TIMEOUT_MS=25000
TRUSTLENS_MAX_RESPONSE_BYTES=2500000
TRUSTLENS_ENABLE_PLAYWRIGHT=1

# Optional local narration via Ollama. Disabled by default; no cloud calls are made.
TRUSTLENS_LLM_ENABLED=0
TRUSTLENS_LLM_MODEL=qwen2.5:1.5b-instruct
TRUSTLENS_OLLAMA_URL=http://127.0.0.1:11434

# Comma-separated extra browser origins allowed to call the API.
TRUSTLENS_ALLOWED_ORIGINS=
